{
  "name": "stashwiki",
  "productName": "StashWiki",
  "version": "0.16.0",
  "description": "A private, offline wiki builder",
  "author": "StashWiki",
  "license": "MIT",
  "homepage": "https://github.com/dingspacedong/StashWiki",
  "repository": {
    "type": "git",
    "url": "https://github.com/dingspacedong/StashWiki.git"
  },
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "icon": "electron scripts/make-icon.cjs",
    "fonts": "node scripts/fonts.mjs",
    "dist:mac": "npm run build && node scripts/pack-mac.mjs",
    "dist:win:noai": "cross-env STASHWIKI_AI=0 electron-vite build && electron-builder --win nsis portable -c.nsis.artifactName=StashWiki-NoAI-Setup-${version}.exe -c.portable.artifactName=StashWiki-NoAI-Portable-${version}.exe"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
