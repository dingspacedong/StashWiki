    "@electron/get": "^5.1.0",
    "@fontsource/almendra": "^5.3.0",
    "@fontsource/amatic-sc": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/audiowide": "^5.3.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/comfortaa": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/comic-relief": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/creepster": "^5.3.0",
    "@fontsource/crimson-pro": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/exo-2": "^5.3.0",
